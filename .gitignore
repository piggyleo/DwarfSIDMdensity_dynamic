# macOS / Finder
.DS_Store
**/.DS_Store

# Local project notes
PROJECT_MEMORY.md

# Python bytecode and interpreter caches
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# Test, type-check, and lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging / build artifacts
build/
dist/
site/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Notebook checkpoints
.ipynb_checkpoints/

# Coverage artifacts
.coverage
.coverage.*
htmlcov/

# Local runtime files
*.pid
*.pid.lock
*.seed

# Keep only descriptive Markdown under data/
data/**
!data/
!data/**/
!data/**/*.md
# But ignore full backup snapshots under data, including their README notes
data/galaxies_backup_*/
data/galaxies_backup_*/**

# Cluster / batch job output
job_*.out
job_*.err
slurm-*.out

# Generated figures, chains, diagnostics, and local matplotlib cache
outputs/
